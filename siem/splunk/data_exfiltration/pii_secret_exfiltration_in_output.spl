`prompthound_audit` (gen_ai_operation_name IN ("chat", "text_completion", "generate_content") "content_output_pii_types{}" IN ("email", "phone", "ssn", "credit_card", "iban", "passport")) OR (gen_ai_operation_name IN ("chat", "text_completion", "generate_content") "content_output_secret_types{}" IN ("api_key", "aws_access_key", "private_key", "bearer_token", "password", "jwt"))
| bin _time span=10m
| stats count as event_count by _time user_tenant_id user_id
| search event_count >= 5
