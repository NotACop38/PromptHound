PromptHoundAuditLog_CL
| where ((gen_ai_operation_name in~ ("chat", "text_completion", "generate_content")) and (array_length(set_intersect(parse_json(translate("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", tostring(content_output_pii_types))), dynamic(["email", "phone", "ssn", "credit_card", "iban", "passport"]))) > 0)) or ((gen_ai_operation_name in~ ("chat", "text_completion", "generate_content")) and (array_length(set_intersect(parse_json(translate("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", tostring(content_output_secret_types))), dynamic(["api_key", "aws_access_key", "private_key", "bearer_token", "password", "jwt"]))) > 0))
| where isnotempty(user_tenant_id) and isnotempty(user_id)
// Fixed 10m UTC windows: a burst that straddles a window boundary is split.
| summarize event_count = count() by user_tenant_id, user_id, bin(timestamp, 10m)
| where event_count >= 5
