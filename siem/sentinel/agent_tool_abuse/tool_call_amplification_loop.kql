PromptHoundAuditLog_CL
| where gen_ai_operation_name in~ ("execute_tool", "invoke_agent")
| where isnotempty(user_tenant_id) and isnotempty(gen_ai_conversation_id)
// Fixed 2m UTC windows: a burst that straddles a window boundary is split.
| summarize event_count = count() by user_tenant_id, gen_ai_conversation_id, bin(timestamp, 2m)
| where event_count >= 15
