PromptHoundAuditLog_CL
| where (gen_ai_operation_name in~ ("execute_tool", "invoke_agent")) and (array_length(set_intersect(parse_json(translate("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", tostring(tool_call_chain))), dynamic(["read_file", "fs.read", "db.query", "sql.query", "secrets.get", "vault.read", "kv.get", "read_email", "inbox.read", "get_credentials"]))) > 0) and (array_length(set_intersect(parse_json(translate("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", tostring(tool_call_chain))), dynamic(["send_email", "http.post", "http.request", "fetch_url", "upload_file", "post_webhook", "slack.post", "sftp.put"]))) > 0)
