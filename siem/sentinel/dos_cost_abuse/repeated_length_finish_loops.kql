PromptHoundAuditLog_CL
| where (gen_ai_operation_name in~ ("chat", "text_completion", "generate_content")) and set_has_element(parse_json(translate("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", tostring(gen_ai_response_finish_reasons))), "length")
| where isnotempty(user_tenant_id) and isnotempty(gen_ai_conversation_id)
// Fixed 5m UTC windows: a burst that straddles a window boundary is split.
| summarize event_count = count() by user_tenant_id, gen_ai_conversation_id, bin(timestamp, 5m)
| where event_count >= 5
