PromptHoundAuditLog_CL
| where ((event_action in~ ("chat", "text_completion")) and (set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "email") or set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "ssn") or set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "credit_card") or set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "phone") or set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "iban") or set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "passport") or set_has_element(parse_json(tolower(tostring(content_output_pii_types))), "api_key"))) or ((event_action in~ ("chat", "text_completion")) and (set_has_element(parse_json(tolower(tostring(content_output_secret_types))), "api_key") or set_has_element(parse_json(tolower(tostring(content_output_secret_types))), "aws_access_key") or set_has_element(parse_json(tolower(tostring(content_output_secret_types))), "private_key") or set_has_element(parse_json(tolower(tostring(content_output_secret_types))), "bearer_token") or set_has_element(parse_json(tolower(tostring(content_output_secret_types))), "password") or set_has_element(parse_json(tolower(tostring(content_output_secret_types))), "jwt")))
| where isnotempty(user_tenant_id) and isnotempty(user_id)
// Fixed UTC buckets; bursts crossing a bucket boundary can be missed.
| summarize event_count = count() by user_tenant_id, user_id, bin(timestamp, 600s)
| where event_count >= 5
