PromptHoundAuditLog_CL
| where ((event_action in~ ("chat", "text_completion")) and (content_output_pii_types in~ ("email", "ssn", "credit_card", "phone", "iban", "passport", "api_key"))) or ((event_action in~ ("chat", "text_completion")) and (content_output_secret_types in~ ("api_key", "aws_access_key", "private_key", "bearer_token", "password", "jwt")))
// PromptHound: the Kusto backend cannot emit Sigma correlations. To complete
// the per-principal windowed aggregation, append the following to the query:
// | summarize event_count = count() by user_id, bin(timestamp, 10m)
// | where event_count >= 5
