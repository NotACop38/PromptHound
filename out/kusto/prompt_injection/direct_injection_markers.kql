PromptHoundAuditLog_CL
| where content_input_injection_markers >= 1 and (gen_ai_input_messages contains "ignore previous instructions" or gen_ai_input_messages contains "ignore all previous instructions" or gen_ai_input_messages contains "ignore the above instructions" or gen_ai_input_messages contains "disregard previous instructions" or gen_ai_input_messages contains "disregard all prior instructions" or gen_ai_input_messages contains "forget your previous instructions" or gen_ai_input_messages contains "override your instructions" or gen_ai_input_messages contains "new instructions:" or gen_ai_input_messages contains "from now on you will" or gen_ai_input_messages contains "you must ignore")
