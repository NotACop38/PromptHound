PromptHoundAuditLog_CL
| where (rag_source_types in~ ("web", "email", "file", "ticket")) and (gen_ai_input_messages contains "ignore previous instructions" or gen_ai_input_messages contains "ignore all previous instructions" or gen_ai_input_messages contains "disregard previous instructions" or gen_ai_input_messages contains "new instructions:" or gen_ai_input_messages contains "from now on you will" or gen_ai_input_messages contains "forward the conversation" or gen_ai_input_messages contains "exfiltrate" or gen_ai_input_messages contains "send the contents to") and content_input_injection_markers >= 1
