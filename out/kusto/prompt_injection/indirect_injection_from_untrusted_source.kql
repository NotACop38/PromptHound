PromptHoundAuditLog_CL
| where (set_has_element(parse_json(tolower(tostring(rag_source_types))), "web") or set_has_element(parse_json(tolower(tostring(rag_source_types))), "email") or set_has_element(parse_json(tolower(tostring(rag_source_types))), "file") or set_has_element(parse_json(tolower(tostring(rag_source_types))), "ticket")) and (gen_ai_input_messages contains "ignore previous instructions" or gen_ai_input_messages contains "ignore all previous instructions" or gen_ai_input_messages contains "disregard previous instructions" or gen_ai_input_messages contains "new instructions:" or gen_ai_input_messages contains "from now on you will" or gen_ai_input_messages contains "forward the conversation" or gen_ai_input_messages contains "exfiltrate" or gen_ai_input_messages contains "send the contents to") and content_input_injection_markers >= 1
