PromptHoundAuditLog_CL
| where (event_action in~ ("execute_tool", "invoke_agent")) and tool_call_outcome =~ "denied"
| where isnotempty(user_tenant_id) and isnotempty(gen_ai_conversation_id)
// Fixed UTC buckets; bursts crossing a bucket boundary can be missed.
| summarize event_count = count() by user_tenant_id, gen_ai_conversation_id, bin(timestamp, 300s)
| where event_count >= 3
