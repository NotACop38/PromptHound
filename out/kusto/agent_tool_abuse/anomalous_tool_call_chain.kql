PromptHoundAuditLog_CL
| where (event_action in~ ("execute_tool", "invoke_agent")) and (tool_call_chain contains "read_file" or tool_call_chain contains "fs.read" or tool_call_chain contains "db.query" or tool_call_chain contains "sql.query" or tool_call_chain contains "secrets.get" or tool_call_chain contains "vault.read" or tool_call_chain contains "kv.get" or tool_call_chain contains "read_email" or tool_call_chain contains "inbox.read" or tool_call_chain contains "get_credentials") and (tool_call_chain contains "send_email" or tool_call_chain contains "http.post" or tool_call_chain contains "http.request" or tool_call_chain contains "fetch_url" or tool_call_chain contains "upload_file" or tool_call_chain contains "post_webhook" or tool_call_chain contains "slack.post" or tool_call_chain contains "sftp.put")
