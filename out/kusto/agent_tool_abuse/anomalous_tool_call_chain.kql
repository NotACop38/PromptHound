PromptHoundAuditLog_CL
| where (event_action in~ ("execute_tool", "invoke_agent")) and (set_has_element(parse_json(tolower(tostring(tool_call_chain))), "read_file") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "fs.read") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "db.query") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "sql.query") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "secrets.get") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "vault.read") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "kv.get") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "read_email") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "inbox.read") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "get_credentials")) and (set_has_element(parse_json(tolower(tostring(tool_call_chain))), "send_email") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "http.post") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "http.request") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "fetch_url") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "upload_file") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "post_webhook") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "slack.post") or set_has_element(parse_json(tolower(tostring(tool_call_chain))), "sftp.put"))
