PromptHoundAuditLog_CL
| where (event_action in~ ("chat", "text_completion")) and (gen_ai_input_messages contains "you are now dan" or gen_ai_input_messages contains "do anything now" or gen_ai_input_messages contains "developer mode" or gen_ai_input_messages contains "ignore your safety guidelines" or gen_ai_input_messages contains "ignore your guidelines" or gen_ai_input_messages contains "bypass your restrictions" or gen_ai_input_messages contains "without any restrictions" or gen_ai_input_messages contains "pretend you have no rules" or gen_ai_input_messages contains "you have no content policy" or gen_ai_input_messages contains "act as an unrestricted") and set_has_element(parse_json(tolower(tostring(gen_ai_response_finish_reasons))), "content_filter")
| where isnotempty(user_tenant_id) and isnotempty(gen_ai_conversation_id)
// Fixed UTC buckets; bursts crossing a bucket boundary can be missed.
| summarize event_count = count() by user_tenant_id, gen_ai_conversation_id, bin(timestamp, 600s)
| where event_count >= 3
