PromptHoundAuditLog_CL
| where (event_action in~ ("chat", "text_completion")) and (gen_ai_input_messages contains "you are now dan" or gen_ai_input_messages contains "do anything now" or gen_ai_input_messages contains "developer mode" or gen_ai_input_messages contains "ignore your safety guidelines" or gen_ai_input_messages contains "ignore your guidelines" or gen_ai_input_messages contains "bypass your restrictions" or gen_ai_input_messages contains "without any restrictions" or gen_ai_input_messages contains "pretend you have no rules" or gen_ai_input_messages contains "you have no content policy" or gen_ai_input_messages contains "act as an unrestricted") and gen_ai_response_finish_reasons =~ "content_filter"
// PromptHound: the Kusto backend cannot emit Sigma correlations. To complete
// the per-principal windowed aggregation, append the following to the query:
// | summarize event_count = count() by gen_ai_conversation_id, bin(timestamp, 10m)
// | where event_count >= 3
