(event_action IN ("chat", "text_completion") content_output_pii_types IN ("email", "ssn", "credit_card", "phone", "iban", "passport", "api_key")) OR (event_action IN ("chat", "text_completion") content_output_secret_types IN ("api_key", "aws_access_key", "private_key", "bearer_token", "password", "jwt"))

| bin _time span=10m
| stats count as event_count by _time user_id

| search event_count >= 5
