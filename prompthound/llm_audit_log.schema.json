{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/notacop38/prompthound/schema/llm_audit_log.schema.json",
  "title": "PromptHound LLM Gateway / Agent Audit Log",
  "description": "v0.1 draft. One JSON object per LLM operation. Field names track the OpenTelemetry GenAI semantic conventions; gateway/identity/network fields are PromptHound additions. Source of truth: docs/PRD.md §10. Tier legend: T1 operational/always-on, T2 content/opt-in, D derived marker.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "timestamp",
    "event.id",
    "event.action",
    "event.outcome"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1"], "description": "[T1] Schema version, e.g. 0.1." },
    "timestamp": { "type": "string", "format": "date-time", "description": "[T1] Event time (ISO 8601)." },
    "event.id": { "type": "string", "minLength": 1, "description": "[T1] Unique event id (uuid)." },
    "event.action": {
      "type": "string",
      "description": "[T1] gen_ai.operation.name.",
      "enum": ["chat", "text_completion", "embeddings", "execute_tool", "invoke_agent"]
    },
    "event.outcome": {
      "type": "string",
      "description": "[T1] Operation outcome.",
      "enum": ["success", "failure", "blocked"]
    },

    "gen_ai.conversation.id": { "type": "string", "minLength": 1, "description": "[T1] Session/conversation id." },
    "gen_ai.provider.name": { "type": "string", "description": "[T1] e.g. openai, anthropic, aws.bedrock." },
    "gen_ai.request.model": { "type": "string", "description": "[T1] Requested model." },
    "gen_ai.response.model": { "type": "string", "description": "[T1] Responding model." },
    "app.name": { "type": "string", "description": "[T1] LLM app/gateway name." },
    "app.env": { "type": "string", "enum": ["prod", "staging", "dev"], "description": "[T1] Environment." },
    "user.id": { "type": "string", "minLength": 1, "description": "[T1] Principal id (pseudonymous)." },
    "user.tenant.id": { "type": "string", "minLength": 1, "description": "[T1] Tenant/org." },
    "user.roles": { "type": "array", "items": { "type": "string" }, "description": "[T1] Authz context." },
    "api_key.id": { "type": "string", "description": "[T1] Hashed/opaque key id (never the secret)." },
    "source.ip": { "type": "string", "description": "[T1] Client IP." },
    "user_agent.original": { "type": "string", "description": "[T1] Client UA." },
    "client.geo.country": { "type": "string", "description": "[T1] Optional geo." },
    "http.request.id": { "type": "string", "description": "[T1] Correlates to upstream HTTP logs." },

    "gen_ai.usage.input_tokens": { "type": "integer", "minimum": 0, "description": "[T1] OTel (not prompt_tokens)." },
    "gen_ai.usage.output_tokens": { "type": "integer", "minimum": 0, "description": "[T1] OTel." },
    "gen_ai.usage.reasoning.output_tokens": { "type": "integer", "minimum": 0, "description": "[T1] Reasoning tokens, if reported." },
    "gen_ai.usage.total_tokens": { "type": "integer", "minimum": 0, "description": "[T1] Convenience sum." },
    "gen_ai.request.temperature": { "type": "number", "description": "[T1]" },
    "gen_ai.request.top_p": { "type": "number", "description": "[T1]" },
    "gen_ai.request.max_tokens": { "type": "integer", "minimum": 0, "description": "[T1]" },
    "gen_ai.request.choice.count": { "type": "integer", "minimum": 0, "description": "[T1] n." },
    "gen_ai.response.finish_reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "[T1] e.g. stop, length, tool_calls, content_filter."
    },
    "gen_ai.client.operation.duration": { "type": "number", "minimum": 0, "description": "[T1] Latency (s)." },
    "cost.usd": { "type": "number", "minimum": 0, "description": "[T1] Gateway-computed cost (denial-of-wallet)." },
    "error.type": { "type": "string", "description": "[T1] Low-cardinality error id." },

    "guardrail.input.flagged": { "type": "boolean", "description": "[T1] Input tripped a guardrail." },
    "guardrail.input.categories": { "type": "array", "items": { "type": "string" }, "description": "[T1] e.g. injection, pii, toxicity." },
    "guardrail.output.flagged": { "type": "boolean", "description": "[T1] Output tripped a guardrail." },
    "guardrail.output.categories": { "type": "array", "items": { "type": "string" }, "description": "[T1]" },
    "policy.decision": { "type": "string", "enum": ["allow", "block", "redact"], "description": "[T1]" },

    "gen_ai.data_source.id": { "type": "array", "items": { "type": "string" }, "description": "[T1] Retrieved source/doc ids; key for indirect injection." },
    "rag.retrieved.count": { "type": "integer", "minimum": 0, "description": "[T1] Chunks retrieved." },
    "rag.source.types": { "type": "array", "items": { "type": "string" }, "description": "[T1] e.g. web, email, file, db, ticket." },

    "gen_ai.agent.id": { "type": "string", "description": "[T1] OTel agent spans." },
    "gen_ai.agent.name": { "type": "string", "description": "[T1]" },
    "gen_ai.tool.name": { "type": "string", "description": "[T1] OTel." },
    "gen_ai.tool.call.id": { "type": "string", "description": "[T1]" },
    "gen_ai.tool.type": { "type": "string", "enum": ["function", "extension", "mcp"], "description": "[T1]" },
    "tool.call.depth": { "type": "integer", "minimum": 0, "description": "[T1] Position in chain." },
    "tool.call.chain": { "type": "array", "items": { "type": "string" }, "description": "[T1] Ordered tool names this turn." },
    "tool.call.outcome": { "type": "string", "enum": ["success", "error", "denied"], "description": "[T1]" },
    "tool.call.arguments": { "type": "object", "description": "[T2] Raw tool args." },
    "tool.call.result": { "type": ["string", "object"], "description": "[T2] Raw tool result." },

    "output.sink": {
      "type": "string",
      "enum": ["html_render", "sql_exec", "shell_exec", "code_eval", "markdown", "downstream_api", "none"],
      "description": "[T1] Downstream sink the output reached."
    },
    "output.rendered_unsanitized": { "type": "boolean", "description": "[T1] Output reached a sink without sanitization (LLM05)." },

    "gen_ai.system_instructions": { "type": "string", "description": "[T2] System prompt text (OTel)." },
    "gen_ai.input.messages": {
      "type": "array",
      "description": "[T2] {role, parts[]}.",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "parts": { "type": "array", "items": {} }
        }
      }
    },
    "gen_ai.output.messages": {
      "type": "array",
      "description": "[T2] {role, parts[], finish_reason}.",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "parts": { "type": "array", "items": {} },
          "finish_reason": { "type": "string" }
        }
      }
    },

    "content.input.injection_markers": { "type": "integer", "minimum": 0, "description": "[D] Count of injection/extraction intent markers in input." },
    "content.output.contains_system_prompt": { "type": "boolean", "description": "[D] Output appears to echo system instructions." },
    "content.output.pii.types": { "type": "array", "items": { "type": "string" }, "description": "[D] e.g. email, ssn, credit_card, api_key." },
    "content.output.secret.types": { "type": "array", "items": { "type": "string" }, "description": "[D] Detected secret/credential classes." }
  }
}
